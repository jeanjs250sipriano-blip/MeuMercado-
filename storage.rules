rules_version = '2';
// Meu Mercado — regras do Firebase Storage
// Leitura pública apenas de imagens de produtos/mercados. Gravação só por quem tem permissão, com limite de tipo e tamanho.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && 'role' in request.auth.token ? request.auth.token.role : null; }
    function marketPerm(marketId, p) {
      return role() == 'market_staff' && 'marketId' in request.auth.token && request.auth.token.marketId == marketId
        && 'perms' in request.auth.token && p in request.auth.token.perms;
    }
    function platformPerm(p) {
      return role() == 'platform_admin'
        || (role() == 'platform_staff' && 'perms' in request.auth.token && p in request.auth.token.perms);
    }
    function validImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Fotos de anúncios de um mercado
    match /markets/{marketId}/products/{file} {
      allow read: if true;
      allow write: if (marketPerm(marketId, 'products.write') || platformPerm('catalog.write')) && validImage();
      allow delete: if marketPerm(marketId, 'products.write') || platformPerm('catalog.write');
    }

    // Logo/capa do mercado
    match /markets/{marketId}/brand/{file} {
      allow read: if true;
      allow write: if (marketPerm(marketId, 'settings.write') || platformPerm('markets.write')) && validImage();
    }

    // Imagens do catálogo global
    match /catalog/{file} {
      allow read: if true;
      allow write: if platformPerm('catalog.write') && validImage();
    }

    // Planilhas de importação (CSV/XLSX) — privadas ao mercado
    match /imports/{marketId}/{file} {
      allow read: if marketPerm(marketId, 'products.import') || platformPerm('catalog.write');
      allow write: if marketPerm(marketId, 'products.import')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Evidências de suporte — privadas ao solicitante e à equipe de suporte
    match /support/{uid}/{file} {
      allow read: if signedIn() && (request.auth.uid == uid || platformPerm('support.read'));
      allow write: if signedIn() && request.auth.uid == uid && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
